<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd 템플릿: YOUR_HOME을 실제 홈 경로로 바꾸고 ~/Library/LaunchAgents/에 복사 후
     launchctl load ~/Library/LaunchAgents/com.example.night-batch.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.night-batch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>YOUR_HOME/bin/night-batch-runner.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>YOUR_HOME/night-batch/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>YOUR_HOME/night-batch/logs/launchd.err.log</string>
</dict>
</plist>
